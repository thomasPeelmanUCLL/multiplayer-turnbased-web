# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgres://dev:dev@localhost:5432/turnbased

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=replace_me_with_a_random_64_byte_hex_string
JWT_REFRESH_SECRET=replace_me_with_a_different_random_64_byte_hex_string

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh token lifetime in days
JWT_REFRESH_EXPIRES_DAYS=7

# ── Server ────────────────────────────────────────────────
PORT=2567

# Comma-separated list of allowed frontend origins
FRONTEND_ORIGIN=http://localhost:5173

# 'development' | 'production'
NODE_ENV=development
